---
const currentYear = new Date().getFullYear();
---

<footer class="relative z-25 border-t border-gray-200 bg-white px-0 md:px-6 dark:border-gray-800 dark:bg-gray-950">
  <div class="relative z-30">
    <div class="mx-auto w-full max-w-6xl border-x-0 border-gray-200 px-6 py-8 md:border-x md:px-12 md:py-10 dark:border-gray-800">
      <div class="flex items-center justify-center">
        <div class="text-center text-sm font-medium tracking-wide text-gray-500 dark:text-gray-400">
          &copy; {currentYear} Francisco Mesa
        </div>
      </div>
    </div>
  </div>
</footer>
