---
import { cn } from "@/lib/utils";

interface Step {
  number: string;
  title: string;
  description: string;
  tags: string[];
}

const steps: Step[] = [
  {
    number: "01",
    title: "Gather your material",
    description:
      "Bring in the PDFs, documents, web pages, or videos you want to learn from. Everything gets read and neatly organized for you.",
    tags: ["PDF", "Documents", "Web", "Video"],
  },
  {
    number: "02",
    title: "Ask in your own words",
    description:
      "Ask whatever you need, just like you would a friend. You get clear answers drawn from your own material, with a note of where each one comes from.",
    tags: ["Natural Q&A", "Source citations"],
  },
  {
    number: "03",
    title: "Make it yours",
    description:
      "Turn everything you have gathered into study guides, flashcards, quizzes, and mind maps — ready whenever you want to review.",
    tags: ["Study guides", "Flashcards", "Mind maps"],
  },
];
---

<section
  id="how-it-works"
  class={cn(
    "relative w-full scroll-mt-20 bg-white px-0 text-gray-900 md:px-6",
    "dark:bg-gray-950 dark:text-white",
    "border-t border-gray-200 dark:border-gray-800",
  )}
>
  <div class="mx-auto w-full max-w-6xl border-x-0 border-gray-200 md:border-x dark:border-gray-800">
    <div class="px-6 py-12 md:px-12 md:py-14">
      <p class="text-xs font-semibold tracking-[0.18em] text-blue-500 uppercase select-none dark:text-blue-400">
        Workflow
      </p>
      <h2 class="mt-3 max-w-2xl text-2xl font-bold tracking-tight text-gray-900 md:text-3xl dark:text-white">
        From scattered sources to structured understanding
      </h2>
      <p class="mt-3 max-w-xl text-sm leading-6 text-gray-600 md:text-base md:leading-7 dark:text-gray-400">
        Every notebook keeps your references, questions, and study tools
        connected in one calm workspace.
      </p>
    </div>

    <ol class="grid grid-cols-1 divide-y divide-gray-200 border-t border-gray-200 md:grid-cols-3 md:divide-x md:divide-y-0 dark:divide-gray-800 dark:border-gray-800">
      {steps.map((step, index) => (
        <li
          class={cn(
            "how-it-works-step flex flex-col justify-between p-6 transition-colors duration-200 hover:bg-gray-50/70 md:py-10 dark:hover:bg-gray-900/35",
            index === 0 && "md:pr-8 md:pl-12 lg:pr-10 lg:pl-12",
            index > 0 && index < steps.length - 1 && "md:px-8 lg:px-10",
            index === steps.length - 1 && "md:pr-12 md:pl-8 lg:pr-12 lg:pl-10",
          )}
          data-how-it-works-step
          style={`--reveal-delay: ${index * 0.12}s;`}
        >
          <div>
            <span class="inline-flex h-6 min-w-8 items-center justify-center rounded-xs border border-blue-200 bg-blue-50/80 px-2 font-mono text-xs font-semibold tracking-wider text-blue-600 tabular-nums select-none dark:border-blue-900/80 dark:bg-blue-950/70 dark:text-blue-300">
              {step.number}
            </span>

            <h3 class="mt-5 text-lg font-semibold tracking-tight text-gray-900 dark:text-white">
              {step.title}
            </h3>
            <p class="mt-2.5 text-sm leading-6 text-gray-600 dark:text-gray-400">
              {step.description}
            </p>
          </div>

          <div class="mt-6 flex flex-wrap gap-1.5">
            {step.tags.map((tag) => (
              <span class="rounded-xs border border-gray-200 bg-white px-2 py-0.5 text-[11px] font-medium text-gray-600 dark:border-gray-800 dark:bg-gray-900/70 dark:text-gray-400">
                {tag}
              </span>
            ))}
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  @media (scripting: enabled) and (prefers-reduced-motion: no-preference) {
    .how-it-works-step {
      opacity: 0;
    }

    .how-it-works-step.is-visible {
      animation: hero-fade-up 0.7s cubic-bezier(0.25, 0.46, 0.45, 0.94)
        var(--reveal-delay, 0s) both;
    }
  }
</style>

<script>
  const initHowItWorksReveal = () => {
    const steps = document.querySelectorAll<HTMLElement>(
      "[data-how-it-works-step]",
    );
    if (!steps.length) return;

    const reduceMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;

    if (reduceMotion) {
      steps.forEach((step) => step.classList.add("is-visible"));
      return;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;

          entry.target.classList.add("is-visible");
          observer.unobserve(entry.target);
        });
      },
      { threshold: 0.15, rootMargin: "0px 0px -8% 0px" },
    );

    steps.forEach((step) => observer.observe(step));
  };

  initHowItWorksReveal();
  document.addEventListener("astro:after-swap", initHowItWorksReveal);
</script>
