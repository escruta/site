<div class="absolute inset-0 z-0 overflow-hidden bg-white dark:bg-gray-950 dark:opacity-65">
  {/* Outer Blue Auras */}
  <div
    style="animation: drift-a 25s ease-in-out infinite;"
    class="absolute bottom-[-60%] left-[-10%] h-[70%] w-[70%] rounded-full bg-blue-400/25 blur-[140px] dark:bg-blue-600/20"
  />
  <div
    style="animation: drift-b 28s ease-in-out 2s infinite;"
    class="absolute right-[-5%] bottom-[-60%] h-[80%] w-[60%] rounded-full bg-blue-300/25 blur-[140px] dark:bg-blue-500/20"
  />

  {/* Inner cores for the glowing wave effect */}
  <div
    style="animation: drift-c 20s ease-in-out 1s infinite;"
    class="absolute bottom-[-90%] left-[-5%] h-[50%] w-[50%] rounded-full bg-blue-200/40 blur-[120px] dark:bg-blue-900/40"
  />
  <div
    style="animation: drift-d 24s ease-in-out 3s infinite;"
    class="absolute right-[-10%] bottom-[-60%] h-[60%] w-[50%] rounded-full bg-blue-100/40 blur-[120px] dark:bg-blue-800/40"
  />
</div>
